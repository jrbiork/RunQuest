{
  "expo": {
    "name": "RunQuest",
    "slug": "runquest",
    "version": "1.0.0",
    "scheme": "runquest",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rbiork.runquest"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#FAFAFA"
      },
      "package": "com.runquest.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunQuest needs your location to track your run distance and path.",
          "locationWhenInUsePermission": "RunQuest needs your location to track your run distance and path."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "RunQuest saves your share cards to your photo library.",
          "savePhotosPermission": "RunQuest saves your share cards to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
