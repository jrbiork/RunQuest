{
  "expo": {
    "name": "RunQuest",
    "slug": "runquest",
    "version": "1.0.0",
    "scheme": "runquest",
    "orientation": "portrait",
    "icon": "./assets/ios_icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0E1210"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rbiork.runquest",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ios_icon.png",
        "backgroundColor": "#0E1210"
      },
      "package": "com.runquest.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/ios_icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#0E1210",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunQuest needs your location to track your run distance and path.",
          "locationWhenInUsePermission": "RunQuest needs your location to track your run distance and path.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        { "enableBackgroundPlayback": true }
      ],
      "./plugins/withReactNativeFirebaseApp.js",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "RunQuest saves your share cards to your photo library.",
          "savePhotosPermission": "RunQuest saves your share cards to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
